{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "agent/**/*.ts",
    "lib/**/*.ts",
    "evals/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "fixtures/**/*.ts",
    "ui/**/*.ts"
  ]
}
