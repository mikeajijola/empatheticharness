# Deployed Gateway and Sandbox use Vercel project OIDC. Local: eve link.
SIMULATOR_PASSWORD=
COMPUTER_INITIAL_URL=
# Public fixture origin, when reverse proxies obscure the public host.
SIMULATOR_PUBLIC_URL=
COMPUTER_MAX_ACTIONS=40
# Acting model is selected per run in chat (defaults to Claude Sonnet 5).
EVALUATOR_MODEL=openai/gpt-4.1-mini

# Chat report archive: local directory, or private Vercel Blob in production.
REPORTS_DIRECTORY=.reports
# Set one of these for the private Blob store; never use a public store.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
